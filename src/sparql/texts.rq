PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX hum: <https://humility.lod4hss.cloud/resource/>
PREFIX lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/>
PREFIX sdh-short: <https://sdhss.org/ontology/shortcuts/>

SELECT DISTINCT ?text ?work_label ?lang ?crea_year ?text_string ?trad_string
WHERE {
  GRAPH hum: {
    # excerpts
    ?text a crm:E33 .
    ?text crm:P190 ?text_string .
    # translations
    ?trad crm:P190 ?trad_string .
    ?text crm:P73 ?trad .
    # expressions
    ?expr a lrmoo:F2 .
    ?expr crm:P165 ?text .
    # language
    ?text crm:P72 ?lang_uri .
    ?lang_uri a crm:E56 .
    ?lang_uri sdh-short:P9 ?lang .
    # optional work for creation date
    OPTIONAL {
      ?work lrmoo:R3 ?expr .
      # work may have optional have a label
      OPTIONAL {
        ?work sdh-short:P9 ?work_label .
      }
      # when a creation exists, retrieve it
      OPTIONAL {
        ?crea crm:P94 ?work .
        ?crea a crm:E65 .
      }
      # creation year can be set using different properties: before/after/...
      # for now, I will not take these differences in account.
      OPTIONAL {
        ?crea sdh-short:P1 ?crea_year_p1 .
      }
      OPTIONAL {
        ?crea sdh-short:P3 ?crea_year_p3 .
      }
      OPTIONAL {
        ?crea sdh-short:P8 ?crea_year_p8 .
      }
    }
    BIND (COALESCE(?crea_year_p1, ?crea_year_p3, ?crea_year_p8) AS ?crea_year)
    FILTER (?text != hum:6a4b69949d774) # exclude test
  }
}
