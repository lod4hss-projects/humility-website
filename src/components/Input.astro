---
const { label, id, type = "text", placeholder = "", value = "" } = Astro.props
---

<!-- TODO: style this -->
<style>
  div {
    margin: 0.4em;
  }
  input {
    max-width: 100%;
  }
</style>

<div>
  <label>{label}</label>
  {(value == "checked" && type == "checkbox" && (
    <input id={id} type="checkbox" checked data-default={value} />
  )) || (
    <input
      id={id}
      type={type}
      placeholder={placeholder}
      value={value}
      data-default={value || ""}
    />
  )}
</div>
