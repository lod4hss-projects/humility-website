---
const { label, id, type = "text", placeholder = "", value = "" } = Astro.props
---

<style>
  div {
    margin: 0.4em;
  }
  input {
    max-width: 100%;
  }
  label {
    margin: 0.4em;
  }
</style>

<div>
  <label for={id}>{label}:</label>
  {(value == "checked" && type == "checkbox" && (
    <input
      {id}
      type="checkbox"
      checked
      data-default={value}
      class="filter-param"
    />
  )) || (
    <input
      {id}
      {type}
      {placeholder}
      {value}
      data-default={value || ""}
      class="filter-param"
    />
  )}
</div>
