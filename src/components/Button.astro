---
const { id } = Astro.props
---

<style>
  button {
    border: 2px solid #04f;
    background-color: #fff;
    padding: 5px;
    margin: 1em;
    text-decoration: none;
    cursor: pointer;
    color: #04f;
    font-weight: bold;
  }
  button:hover {
    background-color: #04f;
    color: white;
  }
</style>
<button {id}>
  <slot />
</button>
