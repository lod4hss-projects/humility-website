---
const {
  title = "Humility in theory and practicy",
  author = "LOD4HSS",
  description = "Humility in Theory and Practice",
  keywords = "humility, history, concept",
  stylesheets = [],
  ...props
} = Astro.props
---

<head>
  <meta charset="utf-8" />
  <meta name="generator" content="pandoc 3.12.1" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  />
  <meta name="author" content={author} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <title>{title}</title>
  {stylesheets.map((i) => (
    <link rel="stylesheet" href={i} />
  ))}
</head>
