---
/* Filter parameters for Passages, Expressions, Works... */
import SelectCSV from "./SelectCSV.astro"
import YearRange from "./YearRange.astro"
import FilterParams from "./FilterParams.astro"
---

<FilterParams legend="work">
  <SelectCSV
    label="Language"
    id="lang"
    csvFileName="passage"
    csvColumn="lang"
  />
  <YearRange />
  <SelectCSV
    label="Work"
    csvFileName="passage"
    csvColumn="work_label"
    id="work"
  />
  <slot />
</FilterParams>
