---
/* Make a `<select>` with an `<option>` for each value. */
const { label, id, values } = Astro.props
---

<style>
  div {
    margin: 0.4em;
  }
  select {
    max-width: 200px;
  }
  option {
    overflow: hidden;
    max-width: 100px;
  }
  label {
    margin: 0.4em;
  }
</style>

<div>
  <label for={id}>{label}:</label>
  <select id={id}>
    {values.map((i) => (
      <option value={i}>{i}</option>
    ))}
  </select>
</div>
