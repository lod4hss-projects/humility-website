---
import Main from "@layouts/Main.astro"
import SelectCSV from "@src/components/SelectCSV.astro"
import Select from "@src/components/Select.astro"
import Input from "@src/components/Input.astro"
const title = "Keyword in context"
---

<Main
  title={title}
  description="Keyword in context for the humility project."
  keywords="keyword, textometry, humility"
>
  <style>
    fieldset {
      border: 1px solid black;
    }
    legend {
      font-size: 0.8em;
    }
    div {
      margin: 1em;
    }
    button {
      border: 2px solid #04f;
      background-color: #fff;
      padding: 5px;
      margin: 1em;
      text-decoration: none;
      cursor: pointer;
      color: #04f;
      font-weight: bold;
    }
    button:hover {
      background-color: #04f;
      color: white;
    }
    select {
      max-width: 100%;
    }
    h1 {
      padding: 0 0.5em;
    }
  </style>
  <style is:global>
    a {
      text-decoration: none;
      color: inherit;
    }
    #kwic {
      padding: 0;
      margin: 0;
    }
    .row {
      width: 100%;
      overflow: hidden;
      white-space: nowrap;
      padding: 0;
      margin: 0;
    }
    .ctx_right {
    }
    .keyword {
      font-weight: bold;
      margin: 0 4pt;
    }
    .ctx_left {
      display: inline-block;
      width: 48%;
      vertical-align: center;
      overflow: hidden;
      white-space: nowrap;
      direction: rtl;
      text-align: right;
    }
  </style>
  <h1>{title}</h1>

  <div id="query">
    <fieldset>
      <legend>word properties</legend>
      <SelectCSV
        label="Dependency label"
        id="dep"
        csvFileName="word"
        csvColumn="dep"
      />
      <SelectCSV
        label="Part of speech"
        id="pos"
        csvFileName="lemma"
        csvColumn="pos"
      />
      <Input label="Hypernym" id="hypernym" />
      <Input label="Lemma" id="lemma" />
    </fieldset>
    <fieldset>
      <legend>corpus</legend>
      <SelectCSV
        label="Text type"
        csvFileName="chunk"
        csvColumn="type"
        id="type"
        empty={false}
      />
      <SelectCSV
        label="Language"
        id="lang"
        csvFileName="passage"
        csvColumn="lang"
      />
      <Input label="Year (start)" id="year-start" />
      <Input label="Year (end)" id="year-end" />
      <SelectCSV
        label="Work"
        csvFileName="passage"
        csvColumn="label"
        id="work"
      />
    </fieldset>
    <fieldset>
      <legend>presentation</legend>
      <Select
        label="Order by"
        id="order-by"
        values={["keyword", "ctx_left", "ctx_right"]}
      />
      <!-- <Input label="Aligned" id="aligned" type="checkbox" value="checked" /> -->
    </fieldset>
    <div>
      <button id="button-submit">submit</button>
      <button id="button-reset">reset</button>
    </div>
  </div>

  <div id="kwic"></div>

  <script>
    import alasql from "alasql"
    import createElement from "@js/util.ts"
    import { BASE_URI } from "@js/util.ts"

    const kwic = document.getElementById("kwic")
    if (!kwic) console.error("no element with id `kwic`")

    type ParamElement = HTMLSelectElement | HTMLInputElement
    type Row = {
      passage_uri: string
      ctx_left: string
      keyword: string
      ctx_right: string
    }

    const ids = [
      "pos",
      "dep",
      "lemma",
      "hypernym",
      "type",
      "lang",
      "work",
      "year-start",
      "year-end",
    ]

    function reset() {
      ids.forEach((id) => {
        const elem = document.getElementById(id) as ParamElement
        if (!elem) console.error(`id not found: ${id}`)
        else {
          if (elem.tagName.toLowerCase() == "select") {
            elem.value = (elem?.childNodes[0] as HTMLOptionElement).value
          } else elem.value = elem["data-default"] || ""
        }
      })
    }

    /* get the query parameters from the user interface. */
    function getQueryParams() {
      const params = []
      for (let i of ids) {
        const elem = document.getElementById(i) as
          HTMLSelectElement | HTMLInputElement
        if (!elem) console.error(`id not found: ${i}`)
        const value = (elem.value || "").trim()
        params.push(value)
        params.push(value)
      }
      return params
    }

    /* run the select KWIC query using user-defined parameters. */
    function runQuery(): Array<Row> {
      const params = getQueryParams()
      const orderBy =
        (document.getElementById("order-by") as HTMLSelectElement).value ||
        "keyword"
      return alasql(
        `
WITH w AS (
  SELECT DISTINCT
    word.idx,
    word.len,
    word.chunk
  FROM word
    JOIN lemma ON lemma.id = word.lemma
    JOIN chunk ON chunk.id = word.chunk
    JOIN passage ON passage.uri = chunk.passage_uri
  WHERE (? = '' OR lemma.pos = ?)
    AND (? = '' OR word.dep = ?)
    AND (? = '' OR lemma.lemma = ?)
    AND (? = '' OR lemma.hypernym_path LIKE '%' + ? + '%')
    AND (? = '' OR chunk.type = ?)
    AND (? = '' OR passage.lang = ?)
    AND (? = '' OR passage.label = ?)
    AND (? = '' OR (passage.year IS NOT NULL AND passage.year >= ?))
    AND (? = '' OR (passage.year IS NOT NULL AND passage.year <= ?))
)
SELECT
  chunk.passage_uri,
  substring(chunk.text, 1, w.idx - 1) AS ctx_left,
  substring(chunk.text, w.idx, w.len) AS keyword,
  substring(chunk.text, w.idx + w.len) AS ctx_right
  FROM w
  JOIN chunk ON chunk.id = w.chunk
  ORDER BY ${orderBy}, keyword, ctx_left, ctx_right`,
        params
      )
    }

    /* update the KWIC table. */
    function update() {
      console.time("query")
      const result = runQuery()
      console.timeEnd("query")
      if (!kwic) return
      kwic.innerHTML = ""
      result.forEach((i) => {
        const row = createElement("div", { className: "row" })
        for (let j of ["ctx_left", "keyword", "ctx_right"]) {
          const span = createElement("span", { className: j })
          console.log(i)
          span.append(
            createElement("a", {
              textContent: i[j],
              href: `${BASE_URI}${i.passage_uri}`,
            })
          )
          row.append(span)
        }
        kwic.append(row)
      })
    }

    /* create tables from CSV files.
     * this is the slowest part of the module. but we cannot really change this.
     * however, we only load data once, so it's fine for now.
     * */
    console.time("tables")
    for (let i of ["lemma", "word", "chunk", "passage"]) {
      await alasql.promise(
        `CREATE TABLE ${i}; SELECT * INTO ${i} FROM csv(?, {separator:","})`,
        [`/data/${i}.csv`]
      )
    }
    console.timeEnd("tables")

    /* extract url query parameters, e.g.: `.../kwic?hypernym=body_part` */
    const params = new URLSearchParams(document.location.search)
    for (let id of ids) {
      const value = params.get(id)
      if (value) (document.getElementById(id) as HTMLInputElement).value = value
    }

    /* fill the kwic */
    update()

    /* bind buttons to functions */
    document.getElementById("button-submit")?.addEventListener("click", update)
    document.getElementById("button-reset")?.addEventListener("click", reset)
  </script>
</Main>
