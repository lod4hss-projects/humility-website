---
const title = "Keyword in context"
const description = "Keyword in context for the humility project."
const keywords = "keyword, textometry, scalable reading, humility, comparison"

import Main from "@layouts/Main.astro"
import Select from "@src/components/Select.astro"
import Submit from "@src/components/Submit.astro"
import WordPropertyParams from "@src/components/WordPropertyParams.astro"
import WorkParams from "@src/components/WorkParams.astro"
import ChunkParams from "@src/components/ChunkParams.astro"
import FilterParams from "@src/components/FilterParams.astro"
---

<Main {title} {description} {keywords}>
  <style>
    /* Non-global styling for element built there. */
    h1 {
      padding: 0 0.5em;
    }
  </style>
  <style is:global>
    /* Global styling for what's created from within the <script>.
    * Astro doesn't see these elements, that's why we need `is:global`. */
    #kwic {
      padding: 0;
      margin: 0;
    }
    #kwic a {
      text-decoration: none;
      color: inherit;
    }
    #kwic .row {
      width: 100%;
      overflow: hidden;
      white-space: nowrap;
      padding: 0;
      margin: 0;
    }
    #kwic .ctx_right {
    }
    #kwic .keyword {
      font-weight: bold;
      margin: 0 4pt;
    }
    #kwic .ctx_left {
      display: inline-block;
      width: 48%;
      vertical-align: center;
      overflow: hidden;
      white-space: nowrap;
      direction: rtl;
      text-align: right;
    }
  </style>
  <h1>{title}</h1>

  <!-- Filters -->
  <div id="query">
    <!-- Token/Word/Lemma properties -->
    <WordPropertyParams />
    <!-- Chunk properties -->
    <ChunkParams>
      <!-- We add a filter 'type' in corpus (text or idea) -->
      <Select
        label="Text property"
        values={["text", "idea"]}
        id="property"
        empty={false}
      />
    </ChunkParams>
    <!-- Work/Expression properties -->
    <WorkParams />
    <!-- Presentation filter specific for KWIC -->
    <FilterParams legend="presentation">
      <legend>presentation</legend>
      <Select
        label="Order by"
        id="order-by"
        values={["keyword", "ctx_left", "ctx_right"]}
      />
    </FilterParams>
    <Submit />
  </div>

  <!-- The KWIC is dynamically created here. -->
  <div id="kwic"></div>

  <script>
    /* (Astro generate imports in <head> from these imports.) */
    import alasql from "alasql"
    import { createElement, BASE_URI } from "@js/util"
    // TODO: use `getFilterParams` and named parameters
    import { csvToTable, getFilterParams } from "@js/sql"

    const kwic = document.getElementById("kwic")
    if (!kwic) console.error("no element with id `kwic`")

    type ParamElement = HTMLSelectElement | HTMLInputElement

    type Row = {
      passage_uri: string
      ctx_left: string
      keyword: string
      ctx_right: string
    }

    const ids = [
      "pos",
      "dep",
      "lemma",
      "hypernym",
      "chunk-type",
      "property",
      "lang",
      "work",
      "year-start",
      "year-end",
    ]

    function reset() {
      ids.forEach((id) => {
        const elem = document.getElementById(id) as ParamElement
        if (!elem) console.error(`id not found: ${id}`)
        else {
          if (elem.tagName.toLowerCase() == "select") {
            elem.value = (elem?.childNodes[0] as HTMLOptionElement).value
          } else elem.value = elem["data-default"] || ""
        }
      })
    }

    /* get the query parameters from the user interface. */
    function getQueryParams() {
      const params = []
      for (let i of ids) {
        const elem = document.getElementById(i) as
          HTMLSelectElement | HTMLInputElement
        if (!elem) console.error(`id not found: ${i}`)
        const value = (elem.value || "").trim()
        params.push(value)
        params.push(value)
      }
      return params
    }

    /* run the select KWIC query using user-defined parameters. */
    function runQuery(): Array<Row> {
      const params = getQueryParams()
      const orderBy =
        (document.getElementById("order-by") as HTMLSelectElement).value ||
        "keyword"
      return alasql(
        `
WITH w AS (
  SELECT DISTINCT
    word.idx,
    word.len,
    word.chunk
  FROM word
    JOIN lemma ON lemma.id = word.lemma
    JOIN chunk ON chunk.id = word.chunk
    JOIN passage ON passage.uri = chunk.passage_uri
  WHERE (? = '' OR lemma.pos = ?)
    AND (? = '' OR word.dep = ?)
    AND (? = '' OR lemma.lemma = ?)
    AND (? = '' OR lemma.hypernym_path LIKE '%' + ? + '%')
    AND (? = '' OR chunk.type = ?)
    AND (? = '' OR chunk.property = ?)
    AND (? = '' OR passage.lang = ?)
    AND (? = '' OR passage.label = ?)
    AND (? = '' OR (passage.year IS NOT NULL AND passage.year >= ?))
    AND (? = '' OR (passage.year IS NOT NULL AND passage.year <= ?))
)
SELECT
  chunk.passage_uri,
  substring(chunk.text, 1, w.idx - 1) AS ctx_left,
  substring(chunk.text, w.idx, w.len) AS keyword,
  substring(chunk.text, w.idx + w.len) AS ctx_right
  FROM w
  JOIN chunk ON chunk.id = w.chunk
  ORDER BY ${orderBy}, keyword, ctx_left, ctx_right`,
        params
      )
    }

    /* update the KWIC table. */
    function update() {
      console.time("query")
      const result = runQuery()
      console.timeEnd("query")
      if (!kwic) return
      kwic.innerHTML = ""
      result.forEach((i) => {
        const row = createElement("div", { className: "row" })
        for (let j of ["ctx_left", "keyword", "ctx_right"]) {
          const span = createElement("span", { className: j })
          span.append(
            createElement("a", {
              textContent: i[j],
              href: `${BASE_URI}${i.passage_uri}`,
            })
          )
          row.append(span)
        }
        kwic.append(row)
      })
    }

    /* create tables from CSV files.
     * this is the slowest part of the module. but we cannot really change this.
     * however, we only load data once, so it's fine for now.
     * */
    for (let i of ["lemma", "word", "chunk", "passage"]) await csvToTable(i)

    /* extract url query parameters, e.g.: `.../kwic?hypernym=body_part` */
    const params = new URLSearchParams(document.location.search)
    for (let id of ids) {
      const value = params.get(id)
      if (value) (document.getElementById(id) as HTMLInputElement).value = value
    }

    /* fill the kwic */
    update()

    /* bind buttons to functions */
    document.getElementById("button-submit")?.addEventListener("click", update)
    document.getElementById("button-reset")?.addEventListener("click", reset)
  </script>
</Main>
