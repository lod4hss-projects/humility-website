---
import Main from "@layouts/Main.astro"
import SelectCSV from "@src/components/SelectCSV.astro"
import Select from "@src/components/Select.astro"
import Input from "@src/components/Input.astro"
---

<Main
  title="Key Word In Context"
  libs={["https://cdn.jsdelivr.net/alasql/0.2/alasql.min.js"]}
>
  <!-- TODO: SASS -->
  <style is:global>
    body {
      font:
        1em "Verdana",
        sans-serif;
      margin: 0;
      padding: 0;
      hyphens: auto;
      overflow-wrap: break-word;
      text-rendering: optimizeLegibility;
      font-kerning: normal;
    }
    @media (max-width: 600px) {
      body {
        font-size: 0.9em;
        padding: 12px;
      }
      h1 {
        font-size: 1.8em;
      }
    }
    fieldset {
      border: 1px solid black;
    }
    legend {
      font-size: 0.8em;
    }
    div {
      margin: 1em;
    }
    label {
      margin: 0.4em;
    }
    .button {
      border: 1px solid blue;
      padding: 5px;
      margin: 1em;
      text-decoration: underline;
      cursor: pointer;
      color: blue;
    }
    .button:hover {
      background-color: blue;
      color: white;
    }
    select {
      max-width: 100%;
    }
    table#kwic {
      border-collapse: collapse;
      border: 1px solid black;
      width: 100%;
    }
    table#kwic .ctx_left {
      vertical-align: top;
      text-align: right;
    }
    table#kwic .ctx_right {
      vertical-align: top;
    }
    table#kwic .keyword {
      vertical-align: top;
      text-align: center;
      font-weight: bold;
      margin-left: 0.5em;
      margin-right: 0.5em;
    }
    table#kwic tr {
      border: 1px solid black;
    }
    table.tb-inline td {
      display: inline;
    }
    a {
      text-decoration: none;
      color: inherit;
    }
    #buttons {
      padding: 0;
    }
    #buttons button {
      margin: 0.4em;
    }
  </style>
  <h1>Key Word In Context</h1>

  <div id="query">
    <fieldset>
      <legend>word properties</legend>
      <SelectCSV label="Dependency label" csvFileName="word" csvColumn="dep" />
      <SelectCSV label="Part of speech" csvFileName="lemma" csvColumn="pos" />
      <Input label="Hypernym" id="hypernym" />
      <Input label="Lemma" id="lemma" />
    </fieldset>
    <fieldset>
      <legend>corpus</legend>
      <SelectCSV
        label="Text type"
        csvFileName="chunk"
        csvColumn="type"
        empty={false}
      />
      <SelectCSV label="Language" csvFileName="passage" csvColumn="lang" />
      <Input label="Year (start)" id="year-start" />
      <Input label="Year (end)" id="year-end" />
      <SelectCSV label="Work" csvFileName="passage" csvColumn="label" />
    </fieldset>
    <fieldset>
      <legend>presentation</legend>
      <Select
        label="Order by"
        id="order-by"
        values={["keyword", "ctx_left", "ctx_right"]}
      />
      <Input label="Aligned" type="checkbox" value="checked" />
    </fieldset>
    <div id="buttons">
      <button id="submit" onclick="updateKWIC()">
        submit
      </button>
      <button id="reset" onclick="reset()">
        reset
      </button>
    </div>
    <!-- TODO: reset -->
  </div>

  <table id="kwic">
    <colgroup>
      <col style="width:45%" />
      <col style="width:10%" />
      <col style="width:45%" />
    </colgroup>
    <tbody id="kwic-tbody"></tbody>
  </table>

  <script is:inline>
    const ROOT = "https://humility.lod4hss.org"
    const BASE_URI = `${ROOT}/sparql-queries/text-page.html?uri=https%3A%2F%2Fhumility.lod4hss.cloud%2Fresource%2F`

    const tbody = document.getElementById("kwic-tbody")

    /* helper function to create an element and set its attributes.
     * it's mostly there to enable one-liner: `div.append(createElement(tag, {id: id}))`
     * */
    function createElement(tag, attrs, callback) {
      const elem = document.createElement(tag)
      if (attrs)
        Object.entries(attrs).forEach(([key, value]) => (elem[key] = value))
      if (callback) callback(elem)
      return elem
    }

    const ids = [
      "select-lemma-pos",
      "select-word-dep",
      "lemma",
      "hypernym",
      "select-chunk-type",
      "select-passage-lang",
      "select-passage-label",
      "year-start",
      "year-end",
    ]

    function reset() {
      ids.forEach((id) => {
        const elem = document.getElementById(id)
        if (!elem) console.error(`id not found: ${i}`)
        if (elem.tagName.toLowerCase() == "select") {
          elem.value = elem.childNodes[0].value
        } else elem.value = elem["data-default"] || ""
      })
    }

    /* get the query parameters from the user interface. */
    function getQueryParams() {
      const params = []
      for (let i of ids) {
        const elem = document.getElementById(i)
        if (!elem) console.error(`id not found: ${i}`)
        const value = (elem.value || "").trim()
        params.push(value)
        params.push(value)
      }
      return params
    }

    /* run the select KWIC query using user-defined parameters. */
    function runQuery() {
      const params = getQueryParams()
      const orderBy = document.getElementById("order-by").value
      return alasql(
        `
WITH w AS (
  SELECT DISTINCT
    word.idx,
    word.len,
    word.chunk
  FROM word
    JOIN lemma ON lemma.id = word.lemma
    JOIN chunk ON chunk.id = word.chunk
    JOIN passage ON passage.uri = chunk.passage_uri
  WHERE (? = '' OR lemma.pos = ?)
    AND (? = '' OR word.dep = ?)
    AND (? = '' OR lemma.lemma LIKE '%' + ? + '%')
    AND (? = '' OR lemma.hypernym_path LIKE '%' + ? + '%')
    AND (? = '' OR chunk.type = ?)
    AND (? = '' OR passage.lang = ?)
    AND (? = '' OR passage.label = ?)
    AND (? = '' OR (passage.year IS NOT NULL AND passage.year >= ?))
    AND (? = '' OR (passage.year IS NOT NULL AND passage.year <= ?))
)
SELECT
  chunk.passage_uri,
  substring(chunk.text, 1, w.idx - 1) AS ctx_left,
  substring(chunk.text, w.idx, w.len) AS keyword,
  substring(chunk.text, w.idx + w.len) AS ctx_right
  FROM w
  JOIN chunk ON chunk.id = w.chunk
  ORDER BY ${orderBy}, keyword, ctx_left, ctx_right
`,
        params
      )
    }

    /* update the KWIC table. */
    function updateKWIC() {
      console.time("query")
      const result = runQuery()
      console.timeEnd("query")
      console.time("update")
      tbody.innerHTML = ""
      result.forEach((i) => {
        const tr = createElement("tr")
        for (let j of ["ctx_left", "keyword", "ctx_right"]) {
          const td = createElement("td", { className: j })
          td.append(
            createElement("a", {
              textContent: i[j],
              href: `${BASE_URI}${i.passage_uri}`,
            })
          )
          tr.append(td)
        }
        tbody.append(tr)
      })
      console.timeEnd("update")
    }

    /* create tables from CSV files.
     * this is the slowest part of the module. but we cannot really change this.
     * however, we only load data once, so it's fine for now.
     * */
    console.time("csv")
    for (let i of ["lemma", "word", "chunk", "passage"]) {
      alasql.promise(
        `create table ${i}; select * into ${i} from csv(?, {separator:","})`,
        [`/data/${i}.csv`]
      )
    }
    console.timeEnd("csv")

    /* create indexes.
     * i don't know if it's really more efficient, but it's quick.
     * */
    console.time("index")
    const indexes = {
      word: ["string", "lemma", "synset"],
      lemma: ["id", "pos"],
      chunk: ["id", "passage_uri", "type"],
      passage: ["uri"],
    }
    Object.entries(indexes).forEach(([t, cols]) => {
      cols.forEach((c) => alasql(`create index index_${t}_${c} on ${t} (${c})`))
    })
    console.timeEnd("index")
  </script>
</Main>
