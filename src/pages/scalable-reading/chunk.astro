---
import Main from "@layouts/Main.astro"
const title = "Chunks Table"
---

<Main {title}>
  <style is:global>
    .text a,
    .concept a {
      text-decoration: underline;
      color: inherit;
      text-decoration-color: #aaa;
    }
    .text a:hover,
    .concept a:hover {
      background-color: #eee;
    }
    .passage_uri a {
      text-decoration: none;
      color: #04d;
    }
    .passage_uri a:hover {
      text-decoration: underline;
    }
    tr:hover {
      background-color: #eee;
    }
    td {
      border-top: 1px solid #ccc;
      padding: 0.6em;
    }
    th {
      text-align: left;
      border-bottom: 1px solid black;
      background-color: #def;
      padding: 0.4em;
      font-weight: normal;
      font-size: 1.3em;
    }
    table {
      border-collapse: collapse;
    }
  </style>

  <div><!-- TODO: heading and small text to present what we're reading --></div>
  <div><!-- TODO: ordering and filtering --></div>

  <table>
    <colgroup>
      <col width="60%" />
      <col width="30%" />
      <col width="5%" />
      <col width="10%" />
    </colgroup>
    <thead>
      <tr>
        <th>Text</th>
        <th>Concept</th>
        <th>Type</th>
        <th>Passage</th>
      </tr>
    </thead>
    <tbody id="tb"></tbody>
  </table>

  <script>
    import * as d3 from "d3"
    import createElement from "@js/util"
    import { BASE_URI } from "@js/util.ts"
    const tb = document.getElementById("tb")
    if (!tb) console.error("element 'tb' not found")
    else
      d3.csv("/data/chunk_lemma.csv").then((data) => {
        data.forEach((i) => {
          const tr = createElement("tr", {})
          for (let j of ["text", "concept"]) {
            const td = createElement("td", { className: j, innerHTML: i[j] })
            for (let a of td.children) {
              const typeName = j == "text" ? "text" : "idea"
              const lemma =
                a.getAttribute("data-lemma") || a.textContent.toLowerCase()
              const href = `/scalable-reading/kwic?lemma=${lemma}&type=${typeName}`
              a.setAttribute("href", href)
            }
            tr.append(td)
          }
          tr.append(createElement("td", { textContent: i.type }))
          const tdPassage = createElement("td", { className: "passage_uri" })
          tdPassage.append(
            createElement("a", {
              href: `${BASE_URI}${i.passage_uri}`,
              textContent: i.passage_uri,
            })
          )
          tr.append(tdPassage)
          tb.append(tr)
        })
      })
  </script>
</Main>
