---
const { title, author, description, keywords, stylesheets, ...props } =
  Astro.props
import Main from "@layouts/Main.astro"
---

<style>
  div {
    padding: 1em;
    margin: 0 1em;
  }
</style>

<style is:global>
  a {
    text-decoration: none;
    color: #06d;
  }
  a:hover {
    text-decoration: underline;
  }
  ul li {
    list-style-type: "⮚ ";
  }
</style>

<Main {title} {author} {description} {keywords} {stylesheets}>
  <div>
    <slot />
  </div>
</Main>
