---
const { title, author, description, keywords, stylesheets, ...props } =
  Astro.props

import Head from "@components/Head.astro"
import Header from "@components/Header.astro"
---

<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml">
  <Head {title} {author} {description} {keywords} {stylesheets} />
  <style>
    html,
    body {
      height: 100%;
      max-height: 100%;
      margin: 0;
      padding: 0;
      font:
        1em "Verdana",
        sans-serif;
      hyphens: auto;
      overflow-wrap: break-word;
      text-rendering: optimizeLegibility;
      font-kerning: normal;
    }
    main {
      margin: 0;
      padding: 0;
    }
  </style>
  <body>
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>
